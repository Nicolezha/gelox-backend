    {
      "name": "RF57",
      "description": "Historial y métricas. Las fechas son yyyy-MM-dd; sin fechas, las métricas toman los últimos 30 días (hora de Bogotá).",
      "item": [
        {
          "name": "01 - Historial paginado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('paginado', () => { pm.expect(r).to.have.property('content'); pm.expect(r).to.have.property('totalElements'); });",
                  "pm.test('cada fila trae el conteo de decisiones', () => r.content.forEach(f => { pm.expect(f).to.have.property('aprobados'); pm.expect(f).to.have.property('rechazados'); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recomendaciones?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recomendaciones"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "02 - Historial filtrado por estado y fechas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('todas PEDIDO_GENERADO', () => pm.response.json().content.forEach(f => pm.expect(f.estado).to.eql('PEDIDO_GENERADO')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recomendaciones?estado=PEDIDO_GENERADO&desde={{desde}}&hasta={{hasta}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recomendaciones"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "PEDIDO_GENERADO"
                },
                {
                  "key": "desde",
                  "value": "{{desde}}"
                },
                {
                  "key": "hasta",
                  "value": "{{hasta}}"
                }
              ]
            }
          }
        },
        {
          "name": "03 - Métricas del rango",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json();",
                  "pm.test('campos', () => ['generadas','itemsSugeridos','aprobados','modificados','rechazados','tasaAprobacion','precisionCantidad'].forEach(c => pm.expect(m).to.have.property(c)));",
                  "pm.test('tasa = (aprobados + modificados) / ítems', () => { if (m.itemsSugeridos > 0) pm.expect(m.tasaAprobacion).to.be.closeTo((m.aprobados + m.modificados) / m.itemsSugeridos, 0.0001); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
