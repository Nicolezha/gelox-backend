# Base de datos (Supabase)
DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=tu_password

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key

# Firebase — el archivo serviceAccountKey.json se monta como volumen
# No necesitas cambiar esta variable para desarrollo local con Docker

# RF55 — LLM del asistente de voz (Groq). Sin estas variables se usa el clasificador anterior
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=tu_clave_de_groq
LLM_MODELO=llama-3.3-70b-versatile

# Contacto de soporte de la plataforma: se muestra en la pantalla de distribuidora bloqueada
PLATAFORMA_SOPORTE_CORREO=soporte@tudominio.com
PLATAFORMA_SOPORTE_WHATSAPP=+57 300 123 4567

# Correos (SMTP de Brevo). MAIL_FROM debe ser un remitente verificado en Brevo
MAIL_USERNAME=tu_login@smtp-brevo.com
MAIL_PASSWORD=tu_smtp_key_de_brevo
MAIL_FROM=remitente_verificado@gmail.com
MAIL_FROM_NAME=GELOX
