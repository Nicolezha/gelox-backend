				{
					"name": "Cuotas del plan (RF70)",
					"description": "Distribuidora B (subdominio {{subdominioB}}) con el plan de cuotas pequeñas del plan de QA (máx. 3 usuarios, 5 productos, 4 comerciantes, 10 MB, 20 llamadas IA/mes) y ya al límite de cada cuota. {{tokenGerenteB}} es el ID Token del Gerente de B. El gerente titular cuenta en la cuota de usuarios.\n\nPreparar el plan en Supabase:\n\nINSERT INTO plan_suscripcion (nombre, descripcion, max_usuarios, max_productos, max_comerciantes,\n                              max_almacenamiento_mb, max_llamadas_ia_mes)\nVALUES ('QA_PEQUENO', 'Plan de QA con cuotas pequeñas', 3, 5, 4, 10, 20)\nON CONFLICT (nombre) DO NOTHING;\nUPDATE distribuidora SET plan_id = (SELECT id FROM plan_suscripcion WHERE nombre = 'QA_PEQUENO')\n WHERE subdominio = 'prueba';",
					"item": [
						{
							"name": "01 - POST usuario n.º 4 con plan de máx. 3 → 409 (CP-70-04)",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{tokenGerenteB}}"
									},
