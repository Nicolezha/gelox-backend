										"value": "application/json"
									}
								],
								"url": {
									"raw": "{{baseUrl}}/api/usuarios",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"usuarios"
									]
								},
								"body": {
									"mode": "raw",
									"raw": "{\n  \"nombre\": \"Vendedor Cuota\",\n  \"correo\": \"vendedor.cuota@gelox-test.com\",\n  \"contrasenaTemporal\": \"Temporal123*\",\n  \"rol\": \"ENCARGADO_VENTAS\"\n}"
								},
								"description": "No debe quedar cuenta en Firebase ni fila en usuario ni fila USUARIO_CREAR en auditoria."
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"pm.test('409 Conflict', () => pm.response.to.have.status(409));",
											"const body = pm.response.json();",
											"pm.test('cuerpo {error, codigo, cuota, limite, usado}', () => {",
											"  pm.expect(body.error).to.eql('Cuota del plan alcanzada');",
											"  pm.expect(body.codigo).to.eql('CUOTA_PLAN_ALCANZADA');",
											"  pm.expect(body.cuota).to.eql('USUARIOS');",
											"  pm.expect(body.limite).to.be.a('number');",
											"  pm.expect(body.usado).to.be.a('number');",
											"});",
											"pm.test('limite del plan QA = 3', () => pm.expect(body.limite).to.eql(3));"
										]
									}
								}
							]
						},
