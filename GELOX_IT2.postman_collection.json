    {
      "name": "RF54",
      "description": "T112 — Motor de recomendación de compras. POST /api/recomendaciones {presupuesto, origen}. Correr en orden: 01 guarda el id que usa 02.",
      "item": [
        {
          "name": "01 - POST generar recomendación (Gerente) → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('trae la forma del contrato RF54', () => {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.estado).to.eql('GENERADA');",
                  "  pm.expect(body.presupuesto).to.eql(80000);",
                  "  pm.expect(body.costoAprobado).to.eql(0);",
                  "  pm.expect(body.confianzaBaja).to.be.a('boolean');",
                  "  pm.expect(body.diasHistorial).to.be.a('number');",
                  "  pm.expect(body.diasConVentas).to.be.a('number');",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.productosExcluidos).to.be.an('array');",
                  "});",
                  "pm.test('costoTotal no supera el presupuesto y suma COMPLETO + REDUCIDO', () => {",
                  "  const suma = body.items.filter(i => i.ajustePresupuesto !== 'EXCLUIDO').reduce((a, i) => a + i.costoEstimado, 0);",
                  "  pm.expect(body.costoTotal).to.be.at.most(80000);",
                  "  pm.expect(Math.round(suma)).to.eql(Math.round(body.costoTotal));",
                  "});",
                  "pm.test('prioridades 1..n y EXCLUIDO con 0 cajas', () => {",
                  "  body.items.forEach((i, idx) => {",
                  "    pm.expect(i.prioridad).to.eql(idx + 1);",
                  "    pm.expect(['CRITICO', 'ALERTA', 'ESTABLE']).to.include(i.urgencia);",
                  "    pm.expect(i.justificacion).to.be.a('string').and.not.empty;",
                  "    if (i.ajustePresupuesto === 'EXCLUIDO') pm.expect(i.cajasSugeridas).to.eql(0);",
                  "  });",
                  "});",
                  "pm.collectionVariables.set('recomendacionId', body.id);",
                  "pm.collectionVariables.set('itemsRecomendacion', body.items.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recomendaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recomendaciones"
              ]
            },
            "description": "Genera y guarda la recomendación con $80.000 (ejemplo de la sección 2.10.7 del FP-15). Guarda el id para la siguiente petición.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"presupuesto\": 80000,\n  \"origen\": \"PANTALLA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "02 - GET detalle de la recomendación guardada → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('quedó guardada con sus ítems y variables', () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('recomendacionId'));",
                  "  pm.expect(body.items.length).to.eql(Number(pm.collectionVariables.get('itemsRecomendacion')));",
                  "  body.items.forEach(i => {",
                  "    pm.expect(i.stockSeguridad).to.be.a('number');",
                  "    pm.expect(i.puntoReorden).to.be.a('number');",
                  "    pm.expect(i.factorEstacionalidad).to.be.a('number');",
                  "    pm.expect(i.decision).to.eql('PENDIENTE');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
