        {
          "name": "01 - GET identidad (Gerente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('trae nombre y colores', () => {",
                  "  pm.expect(body.nombreComercial).to.be.a('string');",
                  "  pm.expect(body.colorPrimario).to.match(/^#[0-9A-Fa-f]{6}$/);",
                  "  pm.expect(body.colorSecundario).to.match(/^#[0-9A-Fa-f]{6}$/);",
                  "});",
                  "pm.collectionVariables.set('nombreComercialOriginal', body.nombreComercial);",
                  "pm.collectionVariables.set('colorPrimarioOriginal', body.colorPrimario);",
                  "pm.collectionVariables.set('colorSecundarioOriginal', body.colorSecundario);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/distribuidora/identidad",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "distribuidora",
                "identidad"
              ]
            },
            "description": "Guarda los valores actuales para restaurarlos al final de la carpeta (08)."
