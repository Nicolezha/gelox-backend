    {
      "name": "RF61",
      "item": [
        {
          "name": "01 - Productos por subdominio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('agrupado por categoría', () => pm.expect(body).to.be.an('object'));",
                  "const nombres = Object.values(body).flat().map(p => p.nombre).sort();",
                  "pm.collectionVariables.set('catalogoSubdominio', JSON.stringify(nombres));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/landing/{{subdominio}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "landing",
                "{{subdominio}}",
                "productos"
              ]
            },
            "description": "Pública (sin token). Guarda los nombres para compararlos con la ruta sin subdominio (02) y con otra distribuidora (03)."
          },
          "response": []
        },
        {
          "name": "02 - Productos sin subdominio = mismo catálogo que magicosabor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const nombres = Object.values(body).flat().map(p => p.nombre).sort();",
                  "pm.test('mismo catálogo que la 01', () => pm.expect(JSON.stringify(nombres)).to.eql(pm.collectionVariables.get('catalogoSubdominio')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/landing/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "landing",
                "productos"
              ]
            },
            "description": "La landing actual (sin subdominio) responde con la distribuidora piloto. Correr después de la 01 con subdominio = magicosabor."
          },
          "response": []
        },
        {
          "name": "03 - Catálogo de otra distribuidora sin productos de la piloto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const propios = Object.values(pm.response.json()).flat().map(p => p.nombre);",
                  "const piloto = JSON.parse(pm.collectionVariables.get('catalogoSubdominio') || '[]');",
                  "pm.test('sin productos de la piloto', () => pm.expect(propios.filter(n => piloto.includes(n))).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
