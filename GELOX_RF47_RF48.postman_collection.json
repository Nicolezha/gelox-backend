    {
      "name": "RF48",
      "description": "Venta rural por voz (RegistrarVentaRuralFlujo). {{token}}: ADMINISTRADOR o ENCARGADO_VENTAS. Requiere Festival activo con stock (al menos 2 cajas) y exactamente un cliente rural cuyo nombre o teléfono contenga \"Marta\". Correr 01 → 02 → 03 seguidos: el comandoId vence a los 15 s.",
      "item": [
        {
          "name": "01 - Interpretar: pedido rural a cliente registrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok=true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('intención REGISTRAR_VENTA', () => pm.expect(body.intencion).to.eql('REGISTRAR_VENTA'));",
                  "pm.test('requiere confirmación', () => pm.expect(body.requiereConfirmacion).to.eql(true));",
                  "pm.test('canal RURAL', () => pm.expect(body.datos.canal).to.eql('RURAL'));",
                  "pm.test('cliente registrado (no destinatario nuevo)', () => pm.expect(body.textoRespuesta).to.not.include('destinatario nuevo'));",
                  "pm.test('envío 8000', () => pm.expect(Number(body.datos.costoEnvio)).to.eql(8000));",
                  "pm.test('total = productos + envío', () => {",
                  "  const d = body.datos;",
                  "  pm.expect(Number(d.total)).to.be.closeTo(Number(d.totalProductos) + Number(d.costoEnvio), 0.001);",
                  "});",
                  "if (body.comandoId) pm.collectionVariables.set('comandoId', body.comandoId);",
                  "if (body.datos) pm.collectionVariables.set('totalRural', body.datos.total);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/voz/interpretar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "voz",
                "interpretar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Vende dos cajas de Festival para doña Marta, envío 8.000\",\n  \"confianza\": 0.95\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Resuelve \"Marta\" contra los clientes rurales (una coincidencia) y responde 200 con requiereConfirmacion=true. datos.total = datos.totalProductos + datos.costoEnvio."
          },
          "response": [
            {
              "name": "200 OK - Pide confirmación",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"comandoId\": \"33333333-3333-3333-3333-333333333333\",\n  \"ok\": true,\n  \"intencion\": \"REGISTRAR_VENTA\",\n  \"requiereConfirmacion\": true,\n  \"expiraEnSegundos\": 15,\n  \"textoRespuesta\": \"Pedido rural para Marta Pérez: 2 cajas de Festival. Envío $8000. Total $23000. ¿Confirmas?\",\n  \"datos\": {\n    \"canal\": \"RURAL\",\n    \"destinatario\": \"Marta Pérez\",\n    \"items\": [\n      {\n        \"productoId\": \"44444444-4444-4444-4444-444444444444\",\n        \"nombre\": \"Festival\",\n        \"cajas\": 2,\n        \"unidades\": 0,\n        \"subtotal\": 15000.0\n      }\n    ],\n    \"costoEnvio\": 8000,\n    \"totalProductos\": 15000.0,\n    \"total\": 23000.0\n  }\n}"
            }
          ]
        },
        {
          "name": "02 - Confirmar: pedido rural",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('estado PROCESADO', () => pm.expect(body.estado).to.eql('PROCESADO'));",
                  "pm.test('trae pedidoRuralId y ventaId', () => {",
                  "  pm.expect(body.datos.pedidoRuralId).to.exist;",
                  "  pm.expect(body.datos.ventaId).to.exist;",
                  "});",
                  "pm.test('total igual al interpretado', () => pm.expect(Number(body.datos.total)).to.be.closeTo(Number(pm.collectionVariables.get('totalRural')), 0.001));",
                  "if (body.datos) {",
                  "  pm.collectionVariables.set('pedidoRuralId', body.datos.pedidoRuralId);",
                  "  pm.collectionVariables.set('ventaId', body.datos.ventaId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/voz/confirmar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "voz",
                "confirmar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comandoId\": \"{{comandoId}}\",\n  \"confirmar\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Corre justo después de 01. Llama a confirmarPedidoRural: crea la venta RURAL y el pedido_rural, y descuenta el stock."
          },
          "response": [
            {
              "name": "200 OK - Pedido rural registrado",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"estado\": \"PROCESADO\",\n  \"textoRespuesta\": \"Pedido rural registrado por $23000.\",\n  \"datos\": {\n    \"ventaId\": \"55555555-5555-5555-5555-555555555555\",\n    \"pedidoRuralId\": \"66666666-6666-6666-6666-666666666666\",\n    \"total\": 23000.0\n  }\n}"
            }
