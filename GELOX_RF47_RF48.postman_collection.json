          "name": "03 - Verificar: el pedido aparece en GET /api/ventas/rural",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const pedido = pm.response.json().find(p => p.pedidoRuralId === pm.collectionVariables.get('pedidoRuralId'));",
                  "pm.test('el pedido confirmado está en el listado', () => pm.expect(pedido).to.exist);",
                  "pm.test('mismo total y envío 8000', () => {",
                  "  pm.expect(Number(pedido.total)).to.be.closeTo(Number(pm.collectionVariables.get('totalRural')), 0.001);",
                  "  pm.expect(Number(pedido.costoEnvio)).to.eql(8000);",
                  "});"
