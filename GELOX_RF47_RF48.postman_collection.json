                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ventas/rural?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ventas",
                "rural"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "El listado va del más reciente al más antiguo, así que el pedido de 02 sale en la primera página."
          },
          "response": []
        },
        {
          "name": "04 - Interpretar: destinatario nuevo con envío \"ocho mil\"",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok=true', () => pm.expect(body.ok).to.eql(true));",
                  "pm.test('destinatario nuevo', () => pm.expect(body.textoRespuesta).to.include('(destinatario nuevo)'));",
                  "pm.test('\"ocho mil\" = 8000', () => pm.expect(Number(body.datos.costoEnvio)).to.eql(8000));",
                  "pm.test('total = productos + envío', () => {",
